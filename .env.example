# Copy this file to .env and fill in your own keys.
#   cp .env.example .env
#
# .env is gitignored and must never be committed.
# Every script loads it automatically through python-dotenv.

# Live train positions and delays.
# Free tier, 1,000 requests a month: https://railradar.in/developers
RAILRADAR_API_KEY=

# Weather at the train's current coordinates.
# Free tier: https://openweathermap.org/api
# New keys can take around ten minutes to activate.
OPENWEATHER_API_KEY=
